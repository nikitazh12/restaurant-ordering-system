POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=restaurant_db

DATABASE_URL=postgresql+psycopg://restaurant_app:replace-with-strong-db-password@db:5432/restaurant_db

SECRET_KEY=replace-with-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_PASSWORD=replace-with-strong-admin-password

VITE_API_URL=https://<domain>/api
BACKEND_CORS_ORIGINS=https://<domain>,https://www.<domain>
